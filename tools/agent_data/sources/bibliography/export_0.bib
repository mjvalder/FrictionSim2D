@article{Zhang2019,
   abstract = {Two-dimensional (2D) materials are crystalline materials made of a single or a few layers of atoms. They have been an active research subject in recent years because of their unique physical and chemical properties. In particular, 2D materials such as graphene, hexagonal BN, and MoS2 exhibit some of the lowest friction coefficients and wear rates, making them attractive for enhancing the efficiency, durability, and environmental compatibility of future mechanical systems. This review will focus on recent advances in the tribology of 2D materials. Starting from general physical characteristics, the essential friction and wear behavior of 2D materials together with the associated mechanisms are reviewed for both interlayer and surface sliding. Influences of the atomic structures of the slip interfaces and environmental factors are discussed, with special attention given to various strategies for achieving friction modulation and superlubricity. Finally, the emerging engineering applications of 2D materials, as well as future prospects, are summarized.},
   author = {Shuai Zhang and Tianbao Ma and Ali Erdemir and Qunyang Li},
   doi = {10.1016/j.mattod.2018.12.002},
   issn = {13697021},
   journal = {Materials Today},
   month = {6},
   note = {<b>Objectives and Purpose:</b><br/> - Reviews recent advances in the tribology of two-dimensional (2D) materials.<br/> - Looks at graphene, hexagonal BN, and MoS2.<br/><b>Methods Used:</b><br/> - Reviewed both interlayer and surface sliding of 2D materials.<br/> - Discussed the influences of the atomic structures of the slip interfaces and environmental factors12.<br/> - Special attention was given to various strategies for achieving friction modulation and superlubricity.<br/><b>Results Obtained:</b><br/> - Friction in graphene is anisotropic based on the sliding angle<br/> - "This finding suggested that the friction induced phonons in 1LG can interact more strongly with electrons resulting in more efficient dissipation. As a consequence, the friction on 1LG will be enhanced due to additional channels of energy dissipation via electron scattering, as schematically shown in Figure 6c." Page 6<br/> - "The simulation results suggested that the influence of electron–phonon coupling was much smaller compared to that of the roughness of the substrate." <b>This may need further investigation</b><br/> - "Therefore, thicker samples with higher bending rigidity will exhibit a weaker puckering effect, leading to a smaller contact area and less friction"<br/>- "Choi et al. proposed that there existed pre-ripples in<br/>graphene due to an inhomogeneous graphene–substrate interaction. Therefore, when the tip scanned across these ripples from different directions, the puckering level would be different and result in anisotropic friction." Page 8-9<br/>- Overall, the effect of humidity on the frictional behavior of graphene seems to be less significant unless the surface chemistry is altered due to long-time exposure to ambient conditions.<br/>- the impacts of humidity on the anti-wear performance of 2D materials should not be discussed alone; instead, they should be considered in combination with influences of other system parameters. ie graphene which can strongly interact with its substrate will not be too affected by humidity, as it wont affect adhesion, but it will help passivate dangling bonds at graphene edges improving wear resistance. <br/>-},
   pages = {67-86},
   publisher = {Elsevier},
   title = {Tribology of Two-Dimensional Materials: From Mechanisms to Modulating Strategies},
   volume = {26},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S1369702118309039},
   year = {2019}
}
@article{Wyatt2021,
   abstract = {<p>2D transition metal carbides, nitrides, and carbonitrides, known as MXenes, were discovered in 2011 and have grown to prominence in energy storage, catalysis, electromagnetic interference shielding, wireless communications, electronic, sensors, and environmental and biomedical applications. In addition to their high electrical conductivity and electrochemically active behavior, MXenes’ mechanical properties, flexibility, and strong adhesion properties play crucial roles in almost all of these growing applications. Although these properties prove to be critical in MXenes’ impressive performance, the mechanical and tribological understanding of MXenes, as well as their relation to the synthesis process, is yet to be fully explored. Here, a fundamental overview of MXenes’ mechanical and tribological properties is provided and the effects of MXenes’ compositions, synthesis, and processing steps on these properties are discussed. Additionally, a critical perspective of the compositional control of MXenes for innovative structural, low‐friction, and low‐wear performance in current and upcoming applications of MXenes is provided. It is established here that the fundamental understanding of MXenes’ mechanical and tribological behavior is essential for their quickly growing applications.</p>},
   author = {Brian C. Wyatt and Andreas Rosenkranz and Babak Anasori},
   doi = {10.1002/adma.202007973},
   issn = {0935-9648},
   issue = {17},
   journal = {Advanced Materials},
   keywords = {2D materials,MXenes,carbides,mechanical properties,tribology},
   month = {4},
   note = {Article about mechanical properties of 2D MXenes. Overall discussion of the structure of 2D MXenes and how they affect material properties such as elasticity and stifness<br/>- 2D MXenes are tunable<br/>- The more layers, the less stiffness due to less strong bonds between the layers than on the surface<br/>- Mention of an MD Reaxff study on 2D MXenes<br/>- What is blade coating?<br/>- Very weak inter-layer bonding making it low shear and interesting for tribo applications<br/>- Mention of various articles for DFT and MD on 2D MXenes (103-105)<br/>- Suggests that through manipulation of surface structure, 2DMXenes could offer very interesting values as a lubricant additive<br/>- Experimental data on 2D MXenes in spray-coated situations. <br/>- Explores etched MXenes<br/>- We need to work on adhesion btw nanosheets and matrix<br/>- Better interlayer properties make MXenes more durable compared to graphene which, once wear appears, degrades completely<br/>-},
   publisher = {John Wiley and Sons Inc},
   title = {2D MXenes: Tunable Mechanical and Tribological Properties},
   volume = {33},
   url = {https://onlinelibrary.wiley.com/doi/10.1002/adma.202007973},
   year = {2021}
}
@article{Spear2015,
   abstract = {This review focuses on recent developments in the use of 2D nanomaterials for controlling the frictional properties of surfaces and interfaces. While materials such as MoS 2 and graphite have been investigated for some time, a host of other layered nanomaterials have emerged as alternatives for friction modification. These advanced lubrication schemes provide an opportunity to address growing needs in energy and materials efficiency and device compatibility , offering improved boundary and solid lubrication of contacting and sliding interfaces. Here, we describe both computational and experimental investigations of the mechanisms and implementations of 2D nanomaterials in the lubrication of interfaces.},
   author = {Jessica C. Spear and Bradley W. Ewers and James D. Batteas},
   doi = {10.1016/j.nantod.2015.04.003},
   issn = {17480132},
   issue = {3},
   journal = {Nano Today},
   keywords = {Boundary lubrication,Graphene,Solid lubrication,Tribology,Two dimensional materials},
   month = {6},
   note = {- Suggests frictionnal qualities of 2D materials are dependent on surface roughness and adhesion<br/>- Majority of sliding occurs between different protective layers<br/>- 2D materials could reduce the number of layers, simplifying the the interface<br/>- Mentions defects, wrinkiling, structure and step edge effects as contriubutors to tribological properties<br/>- Main strength for low COF is weakness in interlayer connections<br/>- Hod et al. use a registery index to illiustrate corrugation in graphene: method is explained<br/>- Use of Metropolis Monte Carlo Brownian Dynamics and Atomic force microscopes<br/>- Single sheet motion is restricted on infinite graphene plane, leading to higher COF. (need multiple sheets in layers?)<br/>- For lubricant additives, small flakes large thermal variations which lead to dislodgement of flakes, however, it is less stable than with larger flakes. Sometimes, however, larger flakes don't have enough thermal energy to be dislodged and thus provide less friction. Middle ground needs to be found.<br/>- Best possible material is multi-layered and small grained structured<br/>- Fabrication methods: exfoliation, chemical vapor deposition, thermal decomposition amd reduction of graphene oxide.<br/>- Wear can be prevented by being in different environments such as in hydrogen where the H passivates dangling bonds and defects in the film ( for graphene)<br/>- chemical reactions can also be used in adhesion<br/>- nanoparticles struggle with dispersion and agglomeration<br/>- particle size plays a huge role},
   pages = {301-314},
   title = {2D-Nanomaterials for Controlling Friction and Wear at Interfaces},
   volume = {10},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S174801321500050X},
   year = {2015}
}
