@article{Osti2016,
   abstract = {MXenes are a recently discovered class of 2D materials with an excellent potential for energy storage applications. Because MXene surfaces are hydrophilic and attractive interaction forces between the layers are relatively weak, water molecules can spontaneously intercalate at ambient humidity and significantly influence the key properties of this 2D material. Using complementary X-ray and neutron scattering techniques, we demonstrate that intercalation with potassium cations significantly improves structural homogeneity and water stability in MXenes. In agreement with molecular dynamics simulations, intercalated potassium ions reduce the water self-diffusion coefficient by 2 orders of magnitude, suggesting greater stability of hydrated MXene against changing environmental conditions.},
   author = {Naresh C. Osti and Michael Naguib and Alireza Ostadhossein and Yu Xie and Paul R. C. Kent and Boris Dyatkin and Gernot Rother and William T. Heller and Adri C. T. van Duin and Yury Gogotsi and Eugene Mamontov},
   doi = {10.1021/acsami.6b01490},
   issn = {1944-8244},
   issue = {14},
   journal = {ACS Applied Materials \& Interfaces},
   keywords = {MXenes,ReaxFF simulation,intercalation,quasi-elastic neutron scattering,water diffusion},
   month = {4},
   note = {<b>Objectives and purpose:</b><br/>-<br/>-<br/>-<br/><br/><b>Methods:</b><br/>-<br/>-<br/>-<br/><br/><b>Results:</b><br/>-<br/>-<br/>-<br/><br/><b>Outlooks:</b><br/>-<br/>-<br/>-<br/>},
   pages = {8859-8863},
   publisher = {American Chemical Society},
   title = {Effect of Metal Ion Intercalation on the Structure of MXene and Water Dynamics on its Internal Surfaces},
   volume = {8},
   url = {https://pubs.acs.org/doi/10.1021/acsami.6b01490},
   year = {2016}
}
@article{Vazirisereshk2020,
   author = {Mohammad R. Vazirisereshk and Kathryn Hasz and Meng-Qiang Zhao and A. T. Charlie Johnson and Robert W. Carpick and Ashlie Martini},
   doi = {10.1021/acsnano.0c07558},
   issn = {1936-0851},
   issue = {11},
   journal = {ACS Nano},
   month = {11},
   note = {Describes the effects of changing the chalcogens in TMDs and their effects on friction.<br/><br/>-results show that despite many models stating that friction should increase with increasing chalcogen size, the opposite was observed. <br/><br/>- DFT, contact area calculations, out-of-plane deformation, contact quality, PES,  were all tried and did not explain the observed results, rather the opposite. <br/><br/>- by observing the trajectory of the "tip", deduced that larger lattice spacing was responsible for lowering friction as it allows for more maneuvrability over saddle points in the energy barriers. <br/><br/>This was coupled with the Prandtl- Tomlinson with thermal activation model. <br/><br/>notable results: Friction increases with increasing energy barriers and decreasing lattice constants. Lattice spacing is IMPORTANT. <br/><br/>Methods: AFM, MD : -Langevin thermostat, used LJ potential and Stillinger Weber, <br/><br/>PTT model described in detail.},
   pages = {16013-16021},
   title = {Nanoscale Friction Behavior of Transition-Metal Dichalcogenides: Role of the Chalcogenide},
   volume = {14},
   url = {https://pubs.acs.org/doi/10.1021/acsnano.0c07558},
   year = {2020}
}
@article{Yang2023,
   abstract = {<p> Reactive molecular dynamics simulations of Ti <sub>3</sub> C <sub>2</sub> T <sub> <italic>x</italic> </sub> with three different surface terminations were used to understand friction and failure of MXenes during sliding at normal pressures from 2–20 GPa and temperatures from 300–1100 K. The O-terminated MXene had the smallest shear stress at low pressures and temperatures, but failed at more severe conditions due to interlayer bonding and the formation of Ti–O–Ti bridges between MXene layers. Failure was not observed for the OH-terminated MXene or a heterostructure combining O- and OH-terminations. For these, at less severe operating conditions, shear stress was smaller for the OH-terminated MXene, while the opposite was observed at higher temperatures and pressures. These trends were explained in terms of adhesion and the complex effect of hydrogen atoms that can either facilitate or hinder sliding, depending on the termination and conditions. Results show that friction and failure are affected by and potentially tunable via MXene surface termination. </p>},
   author = {Quanpeng Yang and Stefan J. Eder and Ashlie Martini and Philipp G. Grützmacher},
   doi = {10.1038/s41529-023-00326-9},
   issn = {2397-2106},
   issue = {1},
   journal = {npj Materials Degradation},
   month = {1},
   note = {Discusses the effect of terminations in MXenes on friction. Compares O, OH, and heterostructures and different pressures and temperatures<br/><br/>Finds that at low pressure and temperature, O terminations are best, in the middle, OH, O termination fails, and at high operating conditions, the heterostructure. <br/><br/>At first it is because adhesive stress is lower in the others, at high operating conditions, it is due to dehyrogenation which lowers the amount of strong H bonds forming which reduces shear stress. This happens more in the heterostructure than in the others, especially at high temperatures. <br/><br/>Shows that there are different factors which lead to reduced friciton in MXenes, and that different materials are ideal depending on the operating conditions.<br/><br/>Method used: ReaxFF on MD, using potentials developped by Osti et al.<br/><br/>NVT environment with Nose Hoover for temperature<br/><br/>harmonic spring with virtual atom to represent AFM tip},
   pages = {6},
   title = {Effect of surface termination on the balance between friction and failure of Ti3C2Tx MXenes},
   volume = {7},
   url = {https://www.nature.com/articles/s41529-023-00326-9},
   year = {2023}
}
