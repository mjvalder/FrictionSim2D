@article{Li2018,
   abstract = {<p>Superlubricity of graphite sliding against graphene can be easily attained at the nanoscale when it forms the incommensurate contact under a low contact pressure. However, the achievement of superlubricity under an ultrahigh contact pressure (&gt;1 GPa), which has more applications in the lubrication of micromachine and nanomachine, remains unclear. Here, this problem is addressed and the robust superlubricity of graphite is obtained under ultrahigh contact pressures of up to 2.52 GPa, by the formation of transferred graphene nanoflakes on a silicon tip. The friction coefficient becomes as low as 0.0003, a state that is attributed to the extremely low shear strength of the graphene/graphite interface in the incommensurate contact. When the pressure exceeds some threshold, the superlubricity state collapses suddenly with the friction coefficient increasing ≈10 times. The failure of superlubricity originates from the delamination of the topmost graphene layers on graphite under ultrahigh contact pressures, which requires the tip to provide additional exfoliation energies during the sliding process. The results demonstrate that the superlubricity of graphite sliding against graphene can exist stably under ultrahigh contact pressure, which would appear to accelerate its application in nanoscale lubrication.</p>},
   author = {Jinjin Li and Jianfeng Li and Jianbin Luo},
   doi = {10.1002/advs.201800810},
   issn = {2198-3844},
   issue = {11},
   journal = {Advanced Science},
   keywords = {graphene,graphite,nanotribology,superlubricity,ultrahigh pressures},
   month = {11},
   pages = {1800810},
   publisher = {John Wiley \& Sons, Ltd},
   title = {Superlubricity of Graphite Sliding against Graphene Nanoflake under Ultrahigh Contact Pressure},
   volume = {5},
   url = {https://onlinelibrary.wiley.com/doi/10.1002/advs.201800810},
   year = {2018}
}
@article{Xu2017,
   abstract = {Nanoscale wear is one of the key factors hindering the performance and lifetime of micro-and nanosystems, such as the scanning tip wear in atomic force microscopy (AFM), the head−disk interface in magnetic storage system, and the moving components in micro-or nanoelectromechanical systems (MEMS/NEMS). Here, we propose to construct the graphene/graphene interfacial architecture to suppress the nanoscale wear. Molecular dynamics simulations show that the atomic roughness of the sliding surfaces with either stepped or amorphous structure can lead to strong inhomogeneity of the local contact pressure distribution. By coating graphene on both sides of the frictional surfaces, the local contact pressure fluctuations due to the atomic roughness are suppressed. Moreover, this trend is more evident with the increasing layer number of the graphene coating. Furthermore, the nanoscratching simulation suggests that the rupture of graphene is driven by the inhomogeneous pressure distribution-induced lateral atomic interlocking between the rough tip and substrate and the consequent in-plane lattice deformation and C−C bond breaking during sliding. By coating graphene on the rough amorphous carbon tip, the critical normal load for wear failure of graphene is significantly increased, due to the weakening effect of the atomic interlocking by improving the contact conditions with atomically smooth graphene/graphene sliding interface. This investigation reveals a strategy for reducing nanowear by suppressing the local contact pressure fluctuations via graphene/graphene sliding interface architecture, which provides a theoretical guidance for designing wear-resistant coatings for the longevity of AFM probes and MEMS/NEMS systems. ■ INTRODUCTION Nanowear process involves the rupture of chemical bonds and the removal of atoms by mechanical action, 1 which hinders the performance of atomic force microscopy (AFM) probes 2,3 and sliding components in micro-or nanoelectromechanical systems (MEMS/NEMS). 4 Great efforts have been made to prepare antiwear materials and coatings, among which, graphene monolayer and graphene films have recently shown unique mechanical and tribological properties, such as large in-plane elastic modulus, 5 high load-carrying capacity, low friction coefficients, 6 and long wear life. 7−10 Previous study has shown that compared to the friction between steel ball in sliding contact with steel substrate extraordinary wear resistance can be achieved even with one-atom-thick graphene coating transferred on the steel substrate. 11 The wear resistance of graphene coating was attributed to the prevention of the formation of interfacial C−C bonds. 12 Also, the wear resistance was enhanced by increasing the number of graphene layers, 11 yet the mechanism is not clear. Recently, chemical vapor deposition (CVD) graphene coating has been prepared on AFM tip for improved functionality, 13 and CVD-grown graphene-coated microsphere probe has been prepared to directly measure the friction between graphene and various two-dimensional (2D) materials by AFM, which acquires sustainable superlubricity. 14 However, it is still a crucial challenge that the wear of graphene could induce the deteriorative protection performance and the breakdown of superlubricity, especially under harsh working conditions. Recent AFM experiments and molecular dynamics (MD) simulations have revealed that the main wear damage is owing to the step edge of layered graphene, 15,16 whereas the wear of monolayer graphene is attributed to the large in-plane stretching when the load surpasses a critical threshold. 17,18 Besides, enhanced nanowear is observed for graphene coatings lying on rough substrates, which is attributed to the nanoscale multiasperity contact and subsequently high local pressure. 7 It has been elucidated that nanowear is strongly dependent on the average normal contact stress. 19,20 However, the effects of atomic-scale surface roughness due to atomic discreteness on the nanowear behaviors are generally overlooked, which have dramatic influence on the local contact pressure distributions, as predicted by Luan et al., 21 and thus should have significant},
   author = {Qiang Xu and Xin Li and Jie Zhang and Yuanzhong Hu and Hui Wang and TianBao Ma},
   doi = {10.1021/acsami.7b11133},
   issn = {1944-8244},
   issue = {46},
   journal = {ACS Applied Materials \& Interfaces},
   keywords = {contact pressure,friction,graphene coating,molecular dynamics simulation,nanowear,surface morphology},
   month = {11},
   pages = {40959-40968},
   publisher = {UTC},
   title = {Suppressing Nanoscale Wear by Graphene/Graphene Interfacial Contact Architecture: A Molecular Dynamics Study},
   volume = {9},
   url = {https://pubs.acs.org/doi/10.1021/acsami.7b11133},
   year = {2017}
}
@article{Xu2023,
   abstract = {<p> Hysteretic friction behavior has been observed on varied 2D nanofilms. However, no unanimous conclusion has yet been drawn on to the exact mechanism or relative contribution of each mechanism to the observed behavior. Here we report on hysteretic friction behavior of supported atomically thin nanofilms studied using atomic force microscopy (AFM) experiments and molecular dynamics (MD) simulations. Load dependent friction measurements were conducted on unheated and heated samples of graphene, h-BN, and MoS <sub>2</sub> supported by silica substrates. Two diverging friction trends are reported: the unheated samples showed higher friction during unloading than during loading, and the heated samples showed a reversed hysteresis. Further, the friction force increased sub-linearly with normal force for heated samples, compared with unheated samples. Tapping mode AFM suggested that the interaction strength of the substrate was increased with heating. Roughened substrates in the MD simulations that mimicked strong/weak interaction forces reproduced the experimental observations and revealed that the evolution of real contact area in different interface interaction situation caused the diverging behaviors. Surface roughness and interaction strength were found to be the key parameters for controlling the out-of-plane deformation of atomically thin nanofilms. </p>},
   author = {Chaochen Xu and Zhijiang Ye and Philip Egberts},
   doi = {10.1038/s41699-022-00363-z},
   issn = {2397-7132},
   issue = {1},
   journal = {npj 2D Materials and Applications},
   keywords = {Atomic force microscopy,Two,dimensional materials},
   month = {1},
   pages = {1},
   publisher = {Nature Publishing Group},
   title = {Friction hysteretic behavior of supported atomically thin nanofilms},
   volume = {7},
   url = {https://www.nature.com/articles/s41699-022-00363-z},
   year = {2023}
}
@article{Cao2020,
   abstract = {By using molecular dynamics simulation, we reveal that Stone-Wales defect increases the friction of graphene in both the armchair and zigzag direction. The friction enhancement results from two distinctive mechanisms. One is the pinning effect between several tip bottom atoms and the heptagons. In this case, the potential barrier of heptagons is larger than hexagons, and therefore the resistance is increased when a tip atom passes above these rings. The other mechanism is that the strong resistance to out-of-plane deformation leads to higher pucker beside the defect at certain moments and thus modifies the configuration of wrinkle. This effect is dependent on the trajectory of sliding. Our study provides new insight into the atomic scale friction of defective graphene.},
   author = {Anbo Cao and Bin Shen and Qiang Lin and Sulin Chen and Zhewei Huang and Zhe Ji and Zhinan Zhang},
   doi = {10.1016/j.commatsci.2019.109423},
   issn = {09270256},
   journal = {Computational Materials Science},
   keywords = {Defect,Friction,Graphene,Interface},
   month = {2},
   note = {Objectives and purpose:<br/>-<br/>-<br/>-<br/><br/>Methods:<br/>-<br/>-<br/>-<br/><br/>Results:<br/>-<br/>-<br/>-<br/><br/>Outlooks:<br/>-<br/>-<br/>-},
   pages = {109423},
   publisher = {Elsevier},
   title = {Influence of Stone-Wales Defect on Graphene Friction: Pinning Effect and Wrinkle Modification},
   volume = {173},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S0927025619307220},
   year = {2020}
}
@article{Ye2017,
   abstract = {Friction on few-layer graphene is known to exhibit unique layer dependence where friction measured via atomic force microscopy (AFM) on the nanometer scale is generally observed to decrease with increasing number of layers. However, this trend is not always observed for AFM probe tips with different sizes and for graphene on different substrates. Within this context, the precise role played by the interface, in particular, the size of the contact and substrate roughness, in the layer dependence of friction on graphene is not yet completely understood. Here, we probe the origins of the roughness dependence of layer-dependent friction on graphene by a combination of AFM measurements and molecular dynamics (MD) simulations. In the experiments, friction is observed to monotonically decrease with increasing number of graphene layers for tips with various apex radii, while the roughness of the sample surface is observed to decrease. In the simulations, two opposite layer-dependence trends for friction are observed on few-layer graphene on substrates with different roughness values. The underlying mechanisms are investigated using atomistic details obtained from the simulations, where the different friction trends are found to originate from an interplay between surface roughness, the trajectory of the tip, and the number of atoms in contact. Finally, the effect of topographical correlation length on the layer dependence of friction on graphene is discussed.},
   author = {Zhijiang Ye and Arda Balkanci and Ashlie Martini and Mehmet Z. Baykara},
   doi = {10.1103/PhysRevB.96.115401},
   issn = {2469-9950},
   issue = {11},
   journal = {Physical Review B},
   month = {9},
   note = {<b>Objectives and purpose:</b><br/>-<br/>-<br/>-<br/><br/><b>Methods:</b><br/>-<br/>-<br/>-<br/><br/><b>Results:</b><br/>-<br/>-<br/>-<br/><br/><b>Outlooks:</b><br/>-<br/>-<br/>-},
   pages = {115401},
   title = {Effect of Roughness on the Layer-Dependent Friction of Few-Layer Graphene},
   volume = {96},
   url = {https://link.aps.org/doi/10.1103/PhysRevB.96.115401},
   year = {2017}
}
@article{Yang2017,
   abstract = {Graphene is an ideal material to study nanoscale friction and modulating its frictional behavior is significant for the development of graphene-based micro- and nanoelectromechanical systems. Recently, strain engineering has been used to tune numerous properties of graphene. However few attentions have been paid to the strain effect on the frictional behavior of graphene. In this study, molecular dynamics simulations were carried out to study the friction coefficient of a strained multilayer graphene during scratching process under different scratch depths. It was found that the friction coefficient decreased under tensile strain while it increased under compressive strain. Further analysis of the atomic scale contact area was conducted to clarify the mechanism of such strain dependence. The results showed that the numbers of contacting atoms decreased as the strain increased from − 8% to 8%, which was consistent with the friction coefficient variations under the applied strain. Therefore, the strain-dependent friction was attributed to the atomic scale contact area variations under the applied strain. This work shed light on the development of strain-based method to control nanoscale friction.},
   author = {Lei Yang and Yanjie Guo and Qi Zhang},
   doi = {10.1016/j.diamond.2016.10.014},
   issn = {09259635},
   journal = {Diamond and Related Materials},
   keywords = {Contacting atoms,Four-layer graphene,Friction coefficient,Scratch,Strain},
   month = {3},
   note = {<b>Objectives and purpose:</b><br/>-<br/>-<br/>-<br/><br/><b>Methods:</b><br/>-<br/>-<br/>-<br/><br/><b>Results:</b><br/>-<br/>-<br/>-<br/><br/><b>Outlooks:</b><br/>-<br/>-<br/>-},
   pages = {273-277},
   publisher = {Elsevier},
   title = {Frictional behavior of strained multilayer graphene: Tuning the atomic scale contact area},
   volume = {73},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S0925963516302370},
   year = {2017}
}
@article{Vazirisereshk2020,
   author = {Mohammad R. Vazirisereshk and Kathryn Hasz and Meng-Qiang Zhao and A. T. Charlie Johnson and Robert W. Carpick and Ashlie Martini},
   doi = {10.1021/acsnano.0c07558},
   issn = {1936-0851},
   issue = {11},
   journal = {ACS Nano},
   month = {11},
   note = {Describes the effects of changing the chalcogens in TMDs and their effects on friction.<br/><br/>-results show that despite many models stating that friction should increase with increasing chalcogen size, the opposite was observed. <br/><br/>- DFT, contact area calculations, out-of-plane deformation, contact quality, PES,  were all tried and did not explain the observed results, rather the opposite. <br/><br/>- by observing the trajectory of the "tip", deduced that larger lattice spacing was responsible for lowering friction as it allows for more maneuvrability over saddle points in the energy barriers. <br/><br/>This was coupled with the Prandtl- Tomlinson with thermal activation model. <br/><br/>notable results: Friction increases with increasing energy barriers and decreasing lattice constants. Lattice spacing is IMPORTANT. <br/><br/>Methods: AFM, MD : -Langevin thermostat, used LJ potential and Stillinger Weber, <br/><br/>PTT model described in detail.},
   pages = {16013-16021},
   title = {Nanoscale Friction Behavior of Transition-Metal Dichalcogenides: Role of the Chalcogenide},
   volume = {14},
   url = {https://pubs.acs.org/doi/10.1021/acsnano.0c07558},
   year = {2020}
}
@article{Zhang2023NonmonotonicFriction,
   author = {Lina Zhang and Weibin Chen and Xinfeng Tan and Jianguo Jiao and Dan Guo and Jianbin Luo},
   doi = {10.1021/acsami.3c09257},
   issn = {1944-8244},
   issue = {38},
   journal = {ACS Applied Materials \& Interfaces},
   month = {9},
   note = {Explores how Te vacancies in MoTe2 leads to phase changes that change the tribological properties of the material. These vacancies/defects can be introduced on purpose. <br/><br/>The point of the research is to show that, if the phase change is reversible, then a large modulation of frictional properties in materials is possible, allowing for better control over frictional properties.<br/><br/>Showed that there is no change in surface contact due to a vacancy, thus proved that the tip movement and height was affected by the vacancy which is why there is an increase in friction due to vacancy defect.<br/><br/>The non-monotonic behaviour is caused by the variation in the tip path. Study suggest there is work to be done in tip path optimization. <br/><br/>MD simultations: Used stillinger-Weber potential<br/>- LJ potential for interlayer<br/>- Langevin thermostat<br/><br/>DFT simulation: <br/>- VASP and Vesta softwares used},
   pages = {45455-45464},
   title = {Nonmonotonic Effects of Atomic Vacancy Defects on Friction},
   volume = {15},
   url = {https://pubs.acs.org/doi/10.1021/acsami.3c09257},
   year = {2023}
}
@article{Chen2021,
   author = {Zhe Chen and Arash Khajeh and Ashlie Martini and Seong H. Kim},
   doi = {10.1021/acsami.0c18098},
   issn = {1944-8244},
   issue = {1},
   journal = {ACS Applied Materials \& Interfaces},
   month = {1},
   note = {Investigates different friction mechanisms at the step edge for graphene so that future researchers can understand what mechanisms are affecting their friction through certain clues. <br/>These mexhanisms include no deformation, buckling, and peeling. <br/><br/>Methods: AFM and MD<br/>MD used ReaxFF which they trained against DFT data, although it supposedly overestimated the elastic modulus of graphene},
   pages = {1895-1902},
   title = {Origin of High Friction at Graphene Step Edges on Graphite},
   volume = {13},
   url = {https://pubs.acs.org/doi/10.1021/acsami.0c18098},
   year = {2021}
}
@article{Hasz2021,
   author = {Kathryn R. Hasz and Mohammad R. Vazirisereshk and Ashlie Martini and Robert W. Carpick},
   doi = {10.1103/PhysRevMaterials.5.083607},
   issn = {2475-9953},
   issue = {8},
   journal = {Physical Review Materials},
   month = {8},
   note = {Investigates non-monotonic behaviour of MoS2 friction depending on temperature between both bulk and monolayer MoS2. <br/><br/>Methods: AFM and MD <br/><br/>TEM of an AFM tip to reproduce it in MD<br/><br/>reactive empirical bond order and Tersoff potential used for substrate and tip respectively.<br/>LJ between tip and substrate. <br/>Langevin thermostat<br/><br/>results: Discusses the validity of the PTT model, stating that it is not accurate as it leaves out important factors, notably the effects of lateral stiffness and adsorbates on the friction. <br/><br/>non-monotonic dependence of friction on temperature is difficult to pinpoint, and mostly under 150K. Depends on many factors, adsorbates could play a crucial role in it though as it increases the energy barrier in some cases.},
   pages = {083607},
   title = {Bifurcation of nanoscale thermolubric friction behavior for sliding on MoS2},
   volume = {5},
   url = {https://link.aps.org/doi/10.1103/PhysRevMaterials.5.083607},
   year = {2021}
}
@article{Vazirisereshk2019,
   abstract = {Ultralow friction can be achieved with 2D materials, particularly graphene and MoS2. The nanotribological properties of these different 2D materials have been measured in previous atomic force microscope (AFM) experiments sequentially, precluding immediate and direct comparison of their frictional behavior. Here, friction is characterized at the nanoscale using AFM experiments with the same tip sliding over graphene, MoS2, and a graphene/MoS2 heterostructure in a single measurement, repeated hundreds of times, and also measured with a slowly varying normal force. The same material systems are simulated using molecular dynamics (MD) and analyzed using density functional theory (DFT) calculations. In both experiments and MD simulations, graphene consistently exhibits lower friction than the MoS2 monolayer and the heterostructure. In some cases, friction on the heterostructure is lower than that on the MoS2 monolayer. Quasi-static MD simulations and DFT calculations show that the origin of the friction contrast is the difference in energy barriers for a tip sliding across each of the three surfaces.},
   author = {Mohammad R. Vazirisereshk and Han Ye and Zhijiang Ye and Alberto Otero-de-la-Roza and Meng-Qiang Zhao and Zhaoli Gao and A. T. Charlie Johnson and Erin R. Johnson and Robert W. Carpick and Ashlie Martini},
   doi = {10.1021/acs.nanolett.9b02035},
   issn = {1530-6984},
   issue = {8},
   journal = {Nano Letters},
   keywords = {Nanoscale friction,atomic force microscope,density-functional theory,graphene versus MoS,heterostructure,molecular dynamics},
   month = {8},
   note = {Report on the difference in friction btw graphene and MoS2 and the heterostructure <br/>- 2D materials are impermeable, good coatings against corrosion and oxidation <br/>- Less friction for more layers of graphene <br/>- properties can be chemically modified with things like flurorination, hydrogenation. and oxidation. <br/>- orientation of graphene also important <br/>- showed that heterostructures had lower interlayer lateral force constants than homogenous bi-layers <br/>- DMT model to calculate normal pressures<br/>- adsorbates in real-life applications affect friction; not foreseen in simulations <br/>- uses a combination of MD and DFT to determine energy barriers <br/>- careful of friction studies using different substrates <br/>- can lead to different results (i.e. metal vs non-metal) <br/>- recommends further study regarding twist angle of heterostructures and how they affect friction <br/>-Clear description of models used in DFT and MD},
   pages = {5496-5505},
   publisher = {American Chemical Society},
   title = {Origin of Nanoscale Friction Contrast between Supported Graphene, MoS2, and a Graphene/MoS2 Heterostructure},
   volume = {19},
   url = {https://pubs.acs.org/doi/10.1021/acs.nanolett.9b02035},
   year = {2019}
}
