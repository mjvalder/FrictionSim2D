{
  "data_dirs": [
    "../../ML_taxonomy/baseline_inputs/tip_campaign/"
  ],
  "labels": [
    "tip_campaign"
  ],
  "plots": [
    {
      "plot_type": "taxonomy_signature_heatmap",
      "filename": "taxonomy_signature_heatmap.png",
      "labels_file": "../../ML_taxonomy/outputs/run_labels.parquet",
      "signatures_file": "../../ML_taxonomy/outputs/run_signatures.parquet",
      "column_level": "channel",
      "top_n": 15,
      "min_runs": 20,
      "annotate_threshold": 1.0,
      "vlim_percentile": 98,
      "colorbar_label": "Median signed z",
      "x_label_rotation": 45
    },
    {
      "plot_type": "taxonomy_prevalence",
      "filename": "taxonomy_phase_diagram_load.png",
      "labels_file": "../../ML_taxonomy/outputs/run_labels.parquet",
      "group_by": "force",
      "normalize": true,
      "extrapolated_style": "tick",
      "legend_outside": true,
      "x_label": "Normal load (nN)",
      "y_label": "Fraction of runs"
    },
    {
      "plot_type": "taxonomy_exemplar",
      "filename": "taxonomy_exemplar_ploughing.png",
      "labels_file": "../../ML_taxonomy/outputs/run_labels.parquet",
      "datasets": [
        "tip_campaign"
      ],
      "filter_size": "100x100y",
      "mode": "ploughing",
      "n_runs": 3,
      "channels": [
        "nf",
        "lateral_force",
        "tipz",
        "comz"
      ],
      "subtract_initial": [
        "tipz",
        "comz"
      ],
      "time_scale": 0.001,
      "x_label": "Time (ps)",
      "legend_location": "upper left"
    },
    {
      "plot_type": "taxonomy_regime_map",
      "filename": "taxonomy_regime_map_l2.png",
      "labels_file": "../../ML_taxonomy/outputs/run_labels.parquet",
      "filter_layer": 2,
      "angle": 0,
      "material_selection": "any_mode",
      "sort_materials": "type",
      "pretty_material_names": true,
      "n_columns": 2,
      "extrapolated_style": "tick",
      "x_label": "Normal load (nN)"
    }
  ]
}
