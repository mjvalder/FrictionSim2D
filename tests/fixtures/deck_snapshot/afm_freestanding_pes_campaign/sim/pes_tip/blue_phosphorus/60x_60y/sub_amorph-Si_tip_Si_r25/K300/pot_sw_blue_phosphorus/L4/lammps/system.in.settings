mass 1*3 28.085000 #Si
mass 4*7 30.973762 #P
mass 8 1.0 #Virtual atom
group tip_all type 1 2 3
group tip_fix type 2
group tip_thermo type 3
group 2D_all type 4 5 6 7
group 2D_core type 4 5 6 7
group layer_1 type 4
group layer_2 type 5
group layer_3 type 6
group layer_4 type 7
group mobile union tip_thermo
pair_style hybrid sw sw sw sw sw lj/cut 11.0
# Self-interactions (intra-component)
pair_coeff * * sw 1 pes_tip/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_blue_phosphorus/provenance/potentials/Si.sw Si Si Si NULL NULL NULL NULL NULL # tip
pair_coeff * * sw 2 pes_tip/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_blue_phosphorus/provenance/potentials/blue_phosphorus.sw NULL NULL NULL P NULL NULL NULL NULL # sheet Layer 1
pair_coeff * * sw 3 pes_tip/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_blue_phosphorus/provenance/potentials/blue_phosphorus.sw NULL NULL NULL NULL P NULL NULL NULL # sheet Layer 2
pair_coeff * * sw 4 pes_tip/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_blue_phosphorus/provenance/potentials/blue_phosphorus.sw NULL NULL NULL NULL NULL P NULL NULL # sheet Layer 3
pair_coeff * * sw 5 pes_tip/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_blue_phosphorus/provenance/potentials/blue_phosphorus.sw NULL NULL NULL NULL NULL NULL P NULL # sheet Layer 4

# Cross-interactions (inter-component LJ)
pair_coeff 1*3 4*7 lj/cut 0.0151840027195286 4.221 # Si(tip)-P(sheet)
pair_coeff 4 5 lj/cut 0.013225837 4.147 # P(L1)-P(L2)
pair_coeff 4 6 lj/cut 0.013225837 4.147 # P(L1)-P(L3)
pair_coeff 4 7 lj/cut 0.013225837 4.147 # P(L1)-P(L4)
pair_coeff 5 6 lj/cut 0.013225837 4.147 # P(L2)-P(L3)
pair_coeff 5 7 lj/cut 0.013225837 4.147 # P(L2)-P(L4)
pair_coeff 6 7 lj/cut 0.013225837 4.147 # P(L3)-P(L4)

# Virtual atom (minimal LJ)
pair_coeff * 8 lj/cut 1e-100 1e-100
