mass 1*5 28.085000 #Si
mass 6*7 72.630000 #Ge
mass 8 1.0 #Virtual atom
group tip_all type 1 2 3
group tip_fix type 2
group tip_thermo type 3
group 2D_all type 4 5 6 7
group 2D_core type 4 5 6 7
group layer_1 type 4 6
group layer_2 type 5 7
group mobile union tip_thermo
pair_style hybrid sw tersoff tersoff lj/cut 11.0
# Self-interactions (intra-component)
pair_coeff * * sw pes_tip/b-SiGe/40x_40y/sub_amorph-Si_tip_Si_r10/K300/pot_tersoff_1989_SiGe/provenance/potentials/Si.sw Si Si Si NULL NULL NULL NULL NULL # tip
pair_coeff * * tersoff 1 pes_tip/b-SiGe/40x_40y/sub_amorph-Si_tip_Si_r10/K300/pot_tersoff_1989_SiGe/provenance/potentials/1989_SiGe.tersoff NULL NULL NULL Si NULL Ge NULL NULL # sheet Layer 1
pair_coeff * * tersoff 2 pes_tip/b-SiGe/40x_40y/sub_amorph-Si_tip_Si_r10/K300/pot_tersoff_1989_SiGe/provenance/potentials/1989_SiGe.tersoff NULL NULL NULL NULL Si NULL Ge NULL # sheet Layer 2

# Cross-interactions (inter-component LJ)
pair_coeff 1*3 4*5 lj/cut 0.0174320868 4.295 # Si(tip)-Si(sheet)
pair_coeff 1*3 6*7 lj/cut 0.0169260632011594 4.2875 # Si(tip)-Ge(sheet)
pair_coeff 4 5 lj/cut 0.0174320868 4.295 # Si(L1)-Si(L2)
pair_coeff 4 7 lj/cut 0.0169260632011594 4.2875 # Si(L1)-Ge(L2)
pair_coeff 5 6 lj/cut 0.0169260632011594 4.2875 # Ge(L1)-Si(L2)
pair_coeff 6 7 lj/cut 0.0164347286 4.28 # Ge(L1)-Ge(L2)

# Virtual atom (minimal LJ)
pair_coeff * 8 lj/cut 1e-100 1e-100
