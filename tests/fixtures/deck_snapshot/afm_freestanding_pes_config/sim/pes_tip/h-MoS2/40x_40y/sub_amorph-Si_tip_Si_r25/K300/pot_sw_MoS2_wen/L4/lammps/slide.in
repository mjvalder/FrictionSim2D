# Freestanding tip-on-slab surface PES scan (self-contained, no substrate).
# A self-supported N-layer slab of the sheet material: layer_1 is held fixed
# (the anchor that removes amorphous-substrate noise), the upper layers relax.
# The rigid tip is placed at a load-calibrated contact gap and grid-scanned
# laterally; total energy and the lateral force on the tip are recorded.

clear
units           metal
atom_style      atomic
boundary        p p p

neighbor        0.3 bin
neigh_modify every 1 delay 0 check yes
comm_style      tiled
thermo          100000
timestep        0.001

region          box block 0.0 41.3928640408997 0.0 38.6047542405695 -4.650000 103.250346
create_box      12 box
read_data       pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/build/tip.lmp add append shift 20.69643202044985 19.30237712028475 82.71294130529489 group tip offset 0 0 0 0 0
read_data       pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/build/h-MoS2_4.lmp add append shift 0.0 0.0 5.0 group 2D offset 3 0 0 0 0
include         pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/L4/lammps/system.in.settings
balance         1.0 rcb

min_style       cg

# layer_1 (bottom slab layer) is the fixed anchor; tip is held rigid throughout.
fix             slab_anchor layer_1 setforce 0.0 0.0 0.0
fix             tip_hold tip_all setforce 0.0 0.0 0.0

# --- 1) settle the slab with the tip held clear ----------------------------------
compute         cz_tip tip_all reduce min z
compute         cz_sheet 2D_all reduce max z
thermo_style    custom step pe c_cz_tip c_cz_sheet
minimize 0.0 1.0e-6 10000 100000
run             0

# --- 2) place the rigid tip at the contact gap above the slab --------------------
variable        approach equal (c_cz_tip-c_cz_sheet)-3.5
displace_atoms  tip_all move 0.0 0.0 $(-v_approach) units box
minimize 0.0 1.0e-6 10000 100000

# --- 3) force the surface exerts on the (rigid, held) tip ------------------------
variable        fx equal f_tip_hold[1]*1.602176634
variable        fy equal f_tip_hold[2]*1.602176634
variable        fz equal f_tip_hold[3]*1.602176634

# --- lateral scan grid over one surface unit cell --------------------------------
variable        Nx     equal 12
variable        Ny     equal 12
variable        Lx     equal 3.1840664646845926
variable        Ly     equal 5.514964891509928
variable        dxstep equal v_Lx/v_Nx
variable        dystep equal v_Ly/v_Ny

print           "# family=pes_tip" file pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/L4/results/pes_scan.csv screen no
print           "x,y,energy_eV,fx,fy,fz" append pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/L4/results/pes_scan.csv screen no

variable        prev_dx equal 0.0
variable        prev_dy equal 0.0

variable        ix loop ${Nx}
label           loop_ix
variable        iy loop ${Ny}
label           loop_iy
variable        dx equal (v_ix-1)*v_dxstep
variable        dy equal (v_iy-1)*v_dystep
displace_atoms  tip_all move $(v_dx-v_prev_dx) $(v_dy-v_prev_dy) 0.0 units box
variable        prev_dx equal $(v_dx)
variable        prev_dy equal $(v_dy)
minimize 0.0 1.0e-6 10000 100000
variable        pe_now equal pe
print           "$(v_dx),$(v_dy),$(v_pe_now),$(v_fx),$(v_fy),$(v_fz)" append pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/L4/results/pes_scan.csv screen no
next            iy
jump            SELF loop_iy
next            ix
jump            SELF loop_ix

# End-of-scan snapshot (integrity stage 3).
write_data      pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/L4/data/final_pes.data