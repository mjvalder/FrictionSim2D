pair_coeff 8 9 lj/cut 0.0118815716 4.035 # S(L1)-S(L2)
pair_coeff 4 6 lj/cut 0.0024283504 3.052 # Mo(L1)-Mo(L3)
pair_coeff 4 10 lj/cut 0.00537146340837286 3.5435 # Mo(L1)-S(L3)
pair_coeff 6 8 lj/cut 0.00537146340837286 3.5435 # S(L1)-Mo(L3)
pair_coeff 8 10 lj/cut 0.0118815716 4.035 # S(L1)-S(L3)
