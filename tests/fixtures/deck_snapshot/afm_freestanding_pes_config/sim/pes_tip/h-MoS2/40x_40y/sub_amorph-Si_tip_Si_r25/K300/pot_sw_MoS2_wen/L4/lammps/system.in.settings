mass 1*3 28.085000 #Si
mass 4*7 95.950000 #Mo
mass 8*11 32.060000 #S
mass 12 1.0 #Virtual atom
group tip_all type 1 2 3
group tip_fix type 2
group tip_thermo type 3
group 2D_all type 4 5 6 7 8 9 10 11
group 2D_core type 4 5 6 7 8 9 10 11
group layer_1 type 4 8
group layer_2 type 5 9
group layer_3 type 6 10
group layer_4 type 7 11
group mobile union tip_thermo
pair_style hybrid sw sw sw sw sw lj/cut 11.0
# Self-interactions (intra-component)
pair_coeff * * sw 1 pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/provenance/potentials/Si.sw Si Si Si NULL NULL NULL NULL NULL NULL NULL NULL NULL # tip
pair_coeff * * sw 2 pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/provenance/potentials/MoS2_wen.sw NULL NULL NULL Mo NULL NULL NULL S NULL NULL NULL NULL # sheet Layer 1
pair_coeff * * sw 3 pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/provenance/potentials/MoS2_wen.sw NULL NULL NULL NULL Mo NULL NULL NULL S NULL NULL NULL # sheet Layer 2
pair_coeff * * sw 4 pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/provenance/potentials/MoS2_wen.sw NULL NULL NULL NULL NULL Mo NULL NULL NULL S NULL NULL # sheet Layer 3
pair_coeff * * sw 5 pes_tip/h-MoS2/40x_40y/sub_amorph-Si_tip_Si_r25/K300/pot_sw_MoS2_wen/provenance/potentials/MoS2_wen.sw NULL NULL NULL NULL NULL NULL Mo NULL NULL NULL S NULL # sheet Layer 4

# Cross-interactions (inter-component LJ)
pair_coeff 1*3 4*7 lj/cut 0.00650624430479018 3.6735 # Si(tip)-Mo(sheet)
pair_coeff 1*3 8*11 lj/cut 0.0143916846634303 4.165 # Si(tip)-S(sheet)
