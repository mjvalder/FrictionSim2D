pair_coeff 7 8 lj/cut 0.00537146340837286 3.5435 # S(L1)-Mo(L4)
pair_coeff 8 11 lj/cut 0.0118815716 4.035 # S(L1)-S(L4)
pair_coeff 5 6 lj/cut 0.0024283504 3.052 # Mo(L2)-Mo(L3)
pair_coeff 5 10 lj/cut 0.00537146340837286 3.5435 # Mo(L2)-S(L3)
pair_coeff 6 9 lj/cut 0.00537146340837286 3.5435 # S(L2)-Mo(L3)
pair_coeff 9 10 lj/cut 0.0118815716 4.035 # S(L2)-S(L3)
pair_coeff 5 7 lj/cut 0.0024283504 3.052 # Mo(L2)-Mo(L4)
pair_coeff 5 11 lj/cut 0.00537146340837286 3.5435 # Mo(L2)-S(L4)
pair_coeff 7 9 lj/cut 0.00537146340837286 3.5435 # S(L2)-Mo(L4)
