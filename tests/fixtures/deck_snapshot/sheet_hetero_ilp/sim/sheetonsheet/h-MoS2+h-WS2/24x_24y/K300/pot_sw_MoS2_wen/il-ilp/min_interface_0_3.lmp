clear
units           metal
atom_style      atomic
boundary        p p p

region box block 0.0 25.480050 0.0 22.066370 -2.500000 26.645595
create_box      15 box

read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/24x_24y/K300/pot_sw_MoS2_wen/il-ilp/a_supercell.lmp add append shift 0.0 0.0 0.0 group g1 offset 0 0 0 0 0 nocoeff
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/24x_24y/K300/pot_sw_MoS2_wen/il-ilp/b_supercell.lmp add append shift 0.0 0.0 6.000000 group g2 offset 3 0 0 0 0 nocoeff
displace_atoms  g2 move 16.986700 14.710914 0.0 units box
mass 1 95.950000 #Mo
mass 2*3 32.060000 #S
mass 8*15 32.060000 #S
mass 4*7 183.840000 #W
include         <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/24x_24y/K300/pot_sw_MoS2_wen/il-ilp/lammps/system.in.settings
run             0

min_style       cg
minimize 1e-4 1e-8 1000000 1000000
variable        z1 equal xcm(g1,z)
variable        z2 equal xcm(g2,z)
variable        lat_c equal v_z2-v_z1
print           "RESULT_LAT_C ${lat_c}"
