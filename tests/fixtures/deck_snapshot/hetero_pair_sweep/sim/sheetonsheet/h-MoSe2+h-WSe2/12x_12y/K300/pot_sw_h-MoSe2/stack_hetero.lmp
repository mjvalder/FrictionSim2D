# LAMMPS: assemble matched per-material supercells into ONE periodic hetero cell.
# Generated by FrictionSim2D assemble_hetero_stack().
#
# The two (or more) per-material coincidence supercells already SHARE one
# in-plane periodic box (Task 3). This script reproduces that shared box, then
# reads every layer into it with:
#   * its z-shift (per-interface spacing from a real minimization),
#   * its global atom-type offset (from the PotentialManager, so assembled
#     types line up with the real potential exactly), and
#   * its in-plane offset = the material's cross-material RI anchor (applied
#     one-sided to the non-reference material only -- NOT centroid-cancelled)
#     plus that layer's own intra-material AA/AB shift.
# The real potential settings are included so masses / pair_style / pair_coeff
# match the registered spine; a single `run 0` validates the assembly before
# it is written to one data file.

clear
units           metal
atom_style      atomic
boundary        p p p

region box block 0.0 13.277511 0.0 11.498662 -2.500000 40.052291
create_box      24 box

# ---- read layers (bottom -> top) ---------------------------------------
# material 0, layer 0  (z = 0.0000)
read_data       <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/a_supercell.lmp add append shift 0.0 0.0 0.000000 group _m0l0 offset 0 0 0 0 0 nocoeff
# material 0, layer 1  (z = 6.0000)
read_data       <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/a_supercell.lmp add append shift 0.0 0.0 6.000000 group _m0l1 offset 0 0 0 0 0 nocoeff
displace_atoms  _m0l1 move 0.000000 3.832887 0.0 units box
# material 1, layer 0  (z = 13.1937)
read_data       <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/b_supercell.lmp add append shift 0.0 0.0 13.193738 group _m1l0 offset 12 0 0 0 0 nocoeff
displace_atoms  _m1l0 move 11.064592 3.832887 0.0 units box
# material 1, layer 1  (z = 19.1937)
read_data       <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/b_supercell.lmp add append shift 0.0 0.0 19.193738 group _m1l1 offset 12 0 0 0 0 nocoeff
displace_atoms  _m1l1 move 11.064592 7.665774 0.0 units box

# ---- masses (explicit, from the PotentialManager registry) --------------
mass 1*4 95.950000 #Mo
mass 5*12 78.971000 #Se
mass 17*24 78.971000 #Se
mass 13*16 183.840000 #W

# ---- real potential (pair_style / pair_coeff / masses) ------------------
include         <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/lammps/system.in.settings

run             0
write_data      <BUILD>/sim/sheetonsheet/h-MoSe2+h-WSe2/12x_12y/K300/pot_sw_h-MoSe2/hetero.data