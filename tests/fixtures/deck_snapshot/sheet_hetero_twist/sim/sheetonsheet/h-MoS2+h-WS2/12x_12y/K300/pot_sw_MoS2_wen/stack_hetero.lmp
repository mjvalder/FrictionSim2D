# LAMMPS: assemble matched per-material supercells into ONE periodic hetero cell.
# Generated by FrictionSim2D assemble_hetero_stack().
#
# The two (or more) per-material coincidence supercells already SHARE one
# in-plane periodic box (Task 3). This script reproduces that shared box, then
# reads every layer into it with:
#   * its z-shift (per-interface spacing from a real minimization),
#   * its global atom-type offset (from the PotentialManager, so assembled
#     types line up with the real potential exactly), and
#   * its in-plane offset = the material's cross-material RI anchor (applied
#     one-sided to the non-reference material only -- NOT centroid-cancelled)
#     plus that layer's own intra-material AA/AB shift.
# The real potential settings are included so masses / pair_style / pair_coeff
# match the registered spine; a single `run 0` validates the assembly before
# it is written to one data file.

clear
units           metal
atom_style      atomic
boundary        p p p

region box block 0.0 58.364902 0.0 16.848496 -2.500000 41.857855
create_box      14 box

# ---- read layers (bottom -> top) ---------------------------------------
# material 0, layer 0  (z = 0.0000)
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/a_twist_supercell.lmp add append shift 0.0 0.0 0.000000 group _m0l0 offset 0 0 0 0 0 nocoeff
# material 0, layer 1  (z = 7.4277)
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/a_twist_supercell.lmp add append shift 0.0 0.0 7.427740 group _m0l1 offset 0 0 0 0 0 nocoeff
displace_atoms  _m0l1 move 0.000000 5.616165 0.0 units box
# material 1, layer 0  (z = 15.2123)
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/b_twist_supercell.lmp add append shift 0.0 0.0 15.212260 group _m1l0 offset 2 0 0 0 0 nocoeff
displace_atoms  _m1l0 move 29.182451 15.725263 0.0 units box
# material 1, layer 1  (z = 21.2123)
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/b_twist_supercell.lmp add append shift 0.0 0.0 21.212260 group _m1l1 offset 2 0 0 0 0 nocoeff
displace_atoms  _m1l1 move 29.182451 21.341428 0.0 units box

# ---- masses (explicit, from the PotentialManager registry) --------------
mass 1 95.950000 #Mo
mass 2 32.060000 #S
mass 7*14 32.060000 #S
mass 3*6 183.840000 #W

# ---- real potential (pair_style / pair_coeff / masses) ------------------
include         <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/lammps/system.in.settings

run             0
write_data      <BUILD>/sim/sheetonsheet/h-MoS2+h-WS2/12x_12y/K300/pot_sw_MoS2_wen/hetero.data