clear
units           metal
atom_style      atomic
boundary        p p p

region box block 0.0 25.472532 0.0 22.059860 -15.000000 37.971934
create_box      9 box

read_data       <BUILD>/sim/sheetonsheet/h-MoS2+flake-h-MoS2/24x_24y/K300/pot_sw_MoS2_wen/build/h-MoS2_2.lmp add append shift 0.0 0.0 0.0 group g_sheet offset 0 0 0 0 0 nocoeff
read_data       <BUILD>/sim/sheetonsheet/h-MoS2+flake-h-MoS2/24x_24y/K300/pot_sw_MoS2_wen/build/flake_h-MoS2_hexagon.data add append shift 3.184066 0.459580 19.844822 group g_flake offset 4 0 0 0 0 nocoeff
change_box      all x final 0.0 25.472532 y final 0.0 22.059860 z final -15.000000 37.971934 units box

mass 1*2 95.950000 #Mo
mass 5*6 95.950000 #Mo
mass 3*4 32.060000 #S
mass 7*8 32.060000 #S
mass 9 1.0 #Virtual atom
include         <BUILD>/sim/sheetonsheet/h-MoS2+flake-h-MoS2/24x_24y/K300/pot_sw_MoS2_wen/lammps/system.in.settings
run             0
write_data      <BUILD>/sim/sheetonsheet/h-MoS2+flake-h-MoS2/24x_24y/K300/pot_sw_MoS2_wen/flake_slide.data
