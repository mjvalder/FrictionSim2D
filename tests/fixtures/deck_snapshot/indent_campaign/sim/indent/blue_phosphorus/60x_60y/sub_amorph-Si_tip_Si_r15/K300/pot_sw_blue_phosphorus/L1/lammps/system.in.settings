mass 1*6 28.085000 #Si
mass 7 30.973762 #P
mass 8 1.0 #Virtual atom
group sub_all type 1 2 3
group sub_fix type 2
group sub_thermo type 3
group tip_all type 4 5 6
group tip_fix type 5
group tip_thermo type 6
group 2D_all type 7
group 2D_core type 7
group layer_1 type 7
group mobile union sub_thermo tip_thermo
pair_style hybrid sw sw sw lj/cut 11.0
# Self-interactions (intra-component)
pair_coeff * * sw 1 indent/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r15/K300/pot_sw_blue_phosphorus/provenance/potentials/Si.sw Si Si Si NULL NULL NULL NULL NULL # sub
pair_coeff * * sw 2 indent/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r15/K300/pot_sw_blue_phosphorus/provenance/potentials/Si.sw NULL NULL NULL Si Si Si NULL NULL # tip
pair_coeff * * sw 3 indent/blue_phosphorus/60x_60y/sub_amorph-Si_tip_Si_r15/K300/pot_sw_blue_phosphorus/provenance/potentials/blue_phosphorus.sw NULL NULL NULL NULL NULL NULL P NULL # sheet

# Cross-interactions (inter-component LJ)
pair_coeff 1*3 4*6 lj/cut 0.0174320868 4.295 # Si(sub)-Si(tip)
pair_coeff 1*3 7 lj/cut 0.0151840027195286 4.221 # Si(sub)-P(sheet)
pair_coeff 4*6 7 lj/cut 0.0151840027195286 4.221 # Si(tip)-P(sheet)

# Virtual atom (minimal LJ)
pair_coeff * 8 lj/cut 1e-100 1e-100
