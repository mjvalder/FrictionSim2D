mass 1*6 28.085000 #Si
mass 7 95.950000 #Mo
mass 8 32.060000 #S
mass 9 1.0 #Virtual atom
group sub_all type 1 2 3
group sub_fix type 2
group sub_thermo type 3
group tip_all type 4 5 6
group tip_fix type 5
group tip_thermo type 6
group 2D_all type 7 8
group 2D_core type 7 8
group layer_1 type 7 8
group mobile union sub_thermo tip_thermo
pair_style hybrid sw sw sw lj/cut 11.0
# Self-interactions (intra-component)
pair_coeff * * sw 1 <OUT>/provenance/potentials/Si.sw Si Si Si NULL NULL NULL NULL NULL NULL # sub
pair_coeff * * sw 2 <OUT>/provenance/potentials/Si.sw NULL NULL NULL Si Si Si NULL NULL NULL # tip
pair_coeff * * sw 3 <OUT>/provenance/potentials/MoS2_wen.sw NULL NULL NULL NULL NULL NULL Mo S NULL # sheet

# Cross-interactions (inter-component LJ)
pair_coeff 1*3 4*6 lj/cut 0.0174320868 4.295 # Si(sub)-Si(tip)
pair_coeff 1*3 7 lj/cut 0.00650624430479018 3.6735 # Si(sub)-Mo(sheet)
pair_coeff 1*3 8 lj/cut 0.0143916846634303 4.165 # Si(sub)-S(sheet)
pair_coeff 4*6 7 lj/cut 0.00650624430479018 3.6735 # Si(tip)-Mo(sheet)
pair_coeff 4*6 8 lj/cut 0.0143916846634303 4.165 # Si(tip)-S(sheet)

# Virtual atom (minimal LJ)
pair_coeff * 9 lj/cut 1e-100 1e-100
