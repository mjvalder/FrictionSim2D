visuals
*.lammpstrj
ptest
# Ignore the scripts/ scratch area by default, but keep the MLIP deliverables
# tracked: the build recipes, Milestone-0 decks, local runner and benchmark are
# referenced by documentation/mlip.md (§12 for Milestone 0), so an
# unqualified `scripts` entry would silently drop them from the repo.
# NB: only /scripts/* is excluded (not /scripts itself), or git would refuse to
# descend into the directory and these negations would never be consulted.
/scripts/*
!/scripts/hpc/
!/scripts/milestone0/
!/scripts/run_local.sh
!/scripts/mlip_bilayer_benchmark.py
!/scripts/fetch_mlip_models.sh
__pycache__
results*
!tests/helpers/results_tree.py
# settings.yaml anywhere is a local, per-user file -- except the deck-snapshot
# fixtures, whose provenance/settings.yaml is part of the deck identity.
settings.yaml
!tests/fixtures/**/settings.yaml
.vscode
.pytest_cache
frictionsim2d-file-audit.md
docs/
AGENTS.md
CLAUDE.md
log.lammps
.conda/
.superpowers/
.stfolder/
MultiplexedPath*

# agent eval results (tests/agent/evals/conftest.py)
tests/agent/evals/.results/
# fine-tune weights: installed from the bundle, never committed
assistant_models/*/model.gguf
# Syncthing ignore patterns: per machine, never synced or committed
.stignore

# Agent worktrees and agent data (not source)
.claude/
tools/agent_data/

# Scratch output of scripts/mlip_bilayer_benchmark.py (defaults to
# `bench_<framework>/` in the CWD); regenerable -- pass --workdir to move it.
bench_*/
