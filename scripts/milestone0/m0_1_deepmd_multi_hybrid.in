# M0.1 — DeePMD: three independent `deepmd` sub-style instances in one
#        `pair_style hybrid`, with NULL type maps + lj/cut.
#        This is the partial-cell mechanism behind setups 1/3/4.
#
# Geometry: trilayer_mos2.data from make_geometries.py — 36 atoms, 6 atom types.
# TYPE LAYOUT (one Mo type and one S type per layer, which is what makes the
# per-layer NULL maps below addressable):
#   1 = Mo layer 1   2 = S layer 1
#   3 = Mo layer 2   4 = S layer 2
#   5 = Mo layer 3   6 = S layer 3
#
# Run:  export LAMMPS_PLUGIN_PATH=...   (see scripts/hpc/README.md)
#       $PREFIX/lammps-deepmd/bin/lmp -in m0_1_deepmd_multi_hybrid.in
#
# PASS: 20 steps complete; finite total energy and forces; the three sub-styles
#       are listed independently in the log; no model-deviation output.

units metal
atom_style atomic
read_data trilayer_mos2.data            # types 1-2 layer1, 3-4 layer2, 5-6 layer3 (Mo,S each)
pair_style hybrid deepmd frozen_model.pth deepmd frozen_model.pth deepmd frozen_model.pth lj/cut 11.0
pair_coeff * * deepmd 1 Mo S NULL NULL NULL NULL
pair_coeff * * deepmd 2 NULL NULL Mo S NULL NULL
pair_coeff * * deepmd 3 NULL NULL NULL NULL Mo S
pair_coeff 1*2 3*4 lj/cut 0.0224 3.13   # interlayer L1-L2 (UFF-ish placeholder values)
pair_coeff 3*4 5*6 lj/cut 0.0224 3.13
pair_coeff 1*2 5*6 lj/cut 1e-100 3.13
# Masses are also in the data file; repeated here so the deck is self-contained.
mass 1 95.95   # Mo
mass 2 32.06   # S
mass 3 95.95   # Mo
mass 4 32.06   # S
mass 5 95.95   # Mo
mass 6 32.06   # S
thermo 1
run 0
fix nve all nve
run 20
