{% import 'common/molecule_ids.lmp' as mol_ids %}
{% import 'common/interlayer_energy.lmp' as il_energy %}
# LAMMPS input script for heterostructure interlayer PES scan
# Static energy-vs-lateral-position map over the matched interface's MINIMAL
# in-plane repeat unit -- measured off the assembled stack by
# src.builders.construction.hetero_stack.detect_inplane_repeat. That is generally a SUB-cell
# of the assembled box: each material is tiled to the configured x/y footprint
# before the coincidence match runs, so a near-lattice-matched pair matches with
# (near-)identity matrices and the box comes out an n x m superlattice of the
# repeat unit.
#   - Bottom layer (layer_1, material 1) frozen.
#   - Top layer (layer_2, material 2) rigid in-plane, grid-scanned laterally.
#   - At each (dx, dy){% if z_relax %} the out-of-plane (z) coordinates relax{% else %} the layers stay rigid{% endif %}, then the
#     total potential energy is recorded, divided by n_cells = how many repeat
#     units tile the box -- so the CSV is an energy PER INTERFACE REPEAT UNIT,
#     independent of the configured footprint and directly comparable with the
#     homogeneous scan's per-unit-cell energy.
# No dynamics, no thermostat, no sliding, no drive: each grid point is one
# energy evaluation. Every path is RUN-DIR-RELATIVE (hetero.data,
# lammps/system.in.settings, results/...), like hetero/slide.lmp: LAMMPS must be
# launched with cwd = the run dir so the settings file's staged
# provenance/potentials/... prefix resolves.

clear
units           metal
atom_style      {{ atom_style }}
{% for directive in mlip_deck_directives | default([]) %}
{{ directive }}
{% endfor %}
boundary        p p p

neighbor        {{ neighbor_list }} bin
{{ neigh_modify_command }}
{% if not mlip_sheet | default(false) %}
{# comm_style tiled breaks pair_deepmd: it derives a bogus ghost count and
   tries to allocate hundreds of GB (host side). Measured 2026-08-11; removing
   `balance` alone does not help, removing tiled does. tiled/RCB exist to spread
   irregular work over many MPI ranks and we run one rank per GPU, so an MLIP
   run loses nothing by falling back to the default brick decomposition. #}
comm_style      tiled
{% endif %}

region          box block {{ xlo }} {{ xhi }} {{ ylo }} {{ yhi }} {{ box_zlo }} {{ box_zhi }} units box
read_data       {{ data_file }} group all_atoms
change_box      all z final {{ box_zlo }} {{ box_zhi }} units box

include         {{ potential_file }}

# ---- Layer groups by initial z-slab (hetero: shared types, so region not type) ----
# Identical convention to hetero/slide.lmp: heterostructure layers share atom
# types, so the type-based layer_N groups the homogeneous PES scan relies on
# cannot exist here. Bands come from compute_layer_zbands (known placement).
{% for layer in layers %}
region          reg_layer_{{ layer.idx }} block INF INF INF INF {{ '%.4f'|format(layer.zlo) }} {{ '%.4f'|format(layer.zhi) }} units box
group           layer_{{ layer.idx }} region reg_layer_{{ layer.idx }}
{% endfor %}
{% if needs_molecule_ids %}
{{ mol_ids.emit_molecule_ids(molecule_groups) -}}
{% endif %}

{% if pot_type == 'reaxff' %}
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
{% elif pot_type == 'reax/c' %}
fix             qeq all qeq/reax 1 0.0 10.0 1.0e-6 reax/c
{% endif %}

velocity        layer_1 set 0.0 0.0 0.0 units box
velocity        layer_2 set 0.0 0.0 0.0 units box

# Bottom layer fully frozen; top layer held rigid in-plane.
fix             freeze_bottom layer_1 setforce 0.0 0.0 0.0
{% if z_relax %}
# setforce with a NULL z-component leaves the top layer free to relax out-of-plane.
fix             top_inplane layer_2 setforce 0.0 0.0 NULL
{% else %}
fix             top_inplane layer_2 setforce 0.0 0.0 0.0
{% endif %}

min_style       {{ min_style }}
timestep        {{ timestep }}
thermo          {{ thermo }}

# --- lateral scan grid over ONE interface repeat unit --------------------------
variable        Nx     equal {{ grid_n }}
variable        Ny     equal {{ grid_n }}
variable        Lx     equal {{ period_x }}
variable        Ly     equal {{ period_y }}
variable        ncell  equal {{ n_cells }}
variable        dxstep equal v_Lx/v_Nx
variable        dystep equal v_Ly/v_Ny

# Energy per interface repeat unit: ncell of them tile the box.
variable        pe_cell equal pe/v_ncell
{% if interlayer_energy_substyle %}
{{ il_energy.emit_interlayer_energy(interlayer_energy_substyle) -}}
# Interlayer term alone, per cell like energy_eV. A bilayer has one layer
# pair, so here "every layer pair" is the scanned interface. In thermo_style
# so c_e_il is current when the print below evaluates it between runs.
variable        e_il_cell equal v_e_int_il_all/v_ncell
thermo_style    custom step pe c_e_il
{% endif %}

# CSV: dx, dy in Angstrom (top-layer displacement); energy_eV per surface cell.
print           "# family=pes_sheet" file {{ results_csv }} screen no
print           "dx,dy,energy_eV{{ ',e_interlayer_eV' if interlayer_energy_substyle else '' }}" append {{ results_csv }} screen no

# We only ever move the top layer by the delta from the previous grid point to
# the current one, so the xy positions stay exactly on the grid (z relaxation
# never touches xy) and periodic wrap-around is harmless. prev_dx/prev_dy are
# snapshotted with immediate $(...) evaluation each step: `variable ... equal v_dx`
# would be re-evaluated lazily (always == current dx), making the delta always 0.
variable        prev_dx equal 0.0
variable        prev_dy equal 0.0

variable        ix loop ${Nx}
label           loop_ix
variable        iy loop ${Ny}
label           loop_iy
variable        dx equal (v_ix-1)*v_dxstep
variable        dy equal (v_iy-1)*v_dystep
displace_atoms  layer_2 move $(v_dx-v_prev_dx) $(v_dy-v_prev_dy) 0.0 units box
variable        prev_dx equal $(v_dx)
variable        prev_dy equal $(v_dy)
{% if z_relax %}
{{ minimization_command }}
{% else %}
run             0
{% endif %}
print           "$(v_dx),$(v_dy),$(v_pe_cell){{ ',$(v_e_il_cell)' if interlayer_energy_substyle else '' }}" append {{ results_csv }} screen no
next            iy
jump            SELF loop_iy
next            ix
jump            SELF loop_ix

# End-of-scan snapshot (integrity stage 3).
write_data      {{ data_dir }}/final_pes.data
