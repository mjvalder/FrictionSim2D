{% import 'common/molecule_ids.lmp' as mol_ids %}
{% import 'common/halt.lmp' as halt_guard %}
{% import 'common/observables.lmp' as obs %}
# LAMMPS Input Script for Flake-on-Sheet Sliding (D4)
# A finite flake driven across a {{ n_layers }}-layer substrate sheet by a
# {{ drive_method }} drive (no tip, no substrate slab). constraint_mode: {{ constraint_mode }}
#
# Derived from templates/hetero/slide.lmp (the proven D1 slide body). Differences:
#   * the DRIVEN group is the flake (by type), NOT a sheet layer_N;
#   * the sheet bottom band (layer_1) is fixed; the sheet interior
#     (layer_2..layer_{{ n_layers }}) + the flake are thermostatted;
#   * the tip-approach and top-sheet-layer rigidify blocks are DROPPED -- a
#     flake slide has no tip, and the sheet top is not a driven body;
#   * the normal load acts on the FLAKE: pressure x the flake's projected area
#     (not the box area), as a per-atom fix addforce (not aveforce -- see the
#     load block);
#   * optional corner-hold keeps the flake rigid in-plane while driven;
#   * friction proxy = bottom-sheet reaction force (many-body sw observable).

{% if scan_speed_config is iterable and scan_speed_config is not string %}
variable        speed index {{ scan_speed_config | join(' ') }}
label           speed_loop
{% else %}
variable        speed equal {{ scan_speed_config }}
{% endif %}

{% if pressures is iterable and pressures is not string %}
variable        pressure index {{ pressures | join(' ') }}
label           pressure_loop
{% else %}
variable        pressure equal {{ pressures }}
{% endif %}

{% if scan_angle_config is iterable and scan_angle_config is not string and scan_angle_config|length > 0 %}
variable        a index {{ scan_angle_config | join(' ') }}
label           angle_loop
{% else %}
variable        a equal {{ scan_angle_config if scan_angle_config is not none else 0 }}
{% endif %}

{% set scan_angle_force_is_sequence = scan_angle_force is iterable and scan_angle_force is not string and scan_angle_force|length > 0 %}
{% if scan_angle_force_is_sequence %}
variable        scan_angle_force index {{ scan_angle_force | join(' ') }}
{% elif scan_angle_force is number %}
variable        scan_angle_force equal {{ scan_angle_force }}
{% endif %}

clear
units           metal
atom_style      {{ atom_style }}
boundary        p p p

neighbor        {{ neighbor_list }} bin
{{ neigh_modify_command }}

comm_style      tiled

region          box block {{ xlo }} {{ xhi }} {{ ylo }} {{ yhi }} {{ box_zlo }} {{ box_zhi }} units box
read_data       {{ data_file }}{% if reserve_virtual_type %} extra/atom/types 1{% endif %} group all_atoms
change_box      all z final {{ box_zlo }} {{ box_zhi }} units box

include         {{ potential_file }}

# ---- Substrate-sheet layer groups: add each initial z-slab to the per-layer type group ----
{% for layer in sheet_layers %}
region          reg_layer_{{ layer.idx }} block INF INF INF INF {{ '%.4f'|format(layer.zlo) }} {{ '%.4f'|format(layer.zhi) }} units box
group           layer_{{ layer.idx }} region reg_layer_{{ layer.idx }}
{% endfor %}

# ---- Flake group (by type: the driven body) ----
group           flake type {{ flake_group_types }}
{% if needs_molecule_ids %}
{{ mol_ids.emit_molecule_ids(molecule_groups) -}}
{% endif %}

{% if pot_type == 'reaxff' %}
fix             qeq all qeq/reaxff 1 0.0 10.0 1.0e-6 reaxff
{% elif pot_type == 'reax/c' %}
fix             qeq all qeq/reax 1 0.0 10.0 1.0e-6 reax/c
{% endif %}

{% if dump_enabled %}
dump            sys all atom {{ dump_freq }} {{ dump_file_pattern }}
{% endif %}

balance         1.0 rcb

min_style       {{ min_style }}
{{ minimization_command }}

# ---- Normal load on the flake (the driven body) ----
# Uniform pressure v_pressure (GPa) over the flake's PROJECTED in-plane area,
# from the [Flake] outline ({{ flake_shape }}, edge_length {{ flake_edge_length }} A):
#   triangle (side a): sqrt(3)/4 a^2 | square (side a): a^2
#   hexagon (circumradius R): 3 sqrt(3)/2 R^2, the regular hexagon
#   components._in_hexagon carves (see flake_projected_area).
# Rotation/twist-invariant. A = {{ '%.4f'|format(flake_area) }} A^2 here.
# 1 eV/A^3 = {{ ev_a3_to_gpa }} GPa; total load P*A (eV/A) split equally per
# flake atom, pointing down onto the sheet -- sheetonsheet/slide.lmp's
# conversion with the flake area in place of the box area.
# fix addforce, NOT aveforce: aveforce replaces every atom's force by the group
# mean, which is harmless on the sheet's rigid/nve top layer but would erase
# the deformable flake's internal, thermostat and corner-hold forces.
# Defined BEFORE the thermostat, corner-hold and drive fixes so f_force[1..3]
# (the group force before this fix adds the load) is the sheet-flake
# interaction alone; its time mean balances the load, so v_fz = +P*A in steady
# sliding and is the COF denominator, in nN like the lateral channels.
variable        A equal {{ flake_area }}
variable        p equal v_pressure/{{ ev_a3_to_gpa }}
variable        f equal -v_p*v_A/(count(flake))
fix             force flake addforce 0.0 0.0 $f
variable        fz equal f_force[3]*{{ ev_a_to_nn }}

# Thermostat: the substrate-sheet interior (layer 2 .. {{ n_layers }}) + the flake.
group           center union {% for i in range(2, n_layers + 1) %}layer_{{ i }} {% endfor %}flake

velocity        center create {{ temp }} {{ seed_sheet_center }}
{% if thermostat_type == 'nose-hoover' %}
fix             nvt_center center nvt temp {{ temp }} {{ temp }} $(100.0*dt)
{% else %}
fix             lang center langevin {{ temp }} {{ temp }} $(100.0*dt) {{ seed_sheet_center }} zero yes tally yes
fix             nve_center center nve
{% endif %}

timestep        {{ timestep }}
thermo          {{ thermo }}

{{ halt_guard.emit_temperature_halt(halt_temperature) }}
# Substrate-sheet bottom band (layer 1): fixed.
fix             fsbot layer_1 setforce 0.0 0.0 0.0
velocity        layer_1 set 0.0 0.0 0.0 units box

# Flake COM (the drive observable, logged to the results file). Template-owned
# (the registry's drivex@flake/drivey@flake/drivez@flake carry no
# lammps_compute/lammps_variable of their own -- same pattern as the sheet's
# own drive{x,y,z}, which alias the top layer's COM the template computes by
# hand), so this block stays hand-written rather than moving into the macro.
compute         COM_flake flake com
variable        comx_flake equal c_COM_flake[1]
variable        comy_flake equal c_COM_flake[2]
variable        comz_flake equal c_COM_flake[3]

# The substrate-sheet's layer COMs (registry-driven: layer_channels(n_layers)
# resolves against the layer_N groups defined above). The flake's own COM is
# NOT here -- it is drivex/drivey/drivez@flake, computed by hand just above.
{{ obs.emit_observables(obs_ctx) }}

{% if corner_hold %}
# Corner-hold: tether the flake corner atoms in xy so the flake stays rigid
# while driven (matching the AFM indentation convention). corner_hold=false
# leaves the flake deformable.
group           flake_corner type {{ flake_corner_types }}
fix             corner_hold flake_corner spring/self {{ flake_corner_k }} xy
{% endif %}

# Friction proxy: bottom-sheet reaction force.
variable        sx equal f_fsbot[1]*{{ ev_a_to_nn }}
variable        sy equal f_fsbot[2]*{{ ev_a_to_nn }}
variable        sz equal f_fsbot[3]*{{ ev_a_to_nn }}

{# compute group/group needs pair->single(): only LJ provides it (LJ-G's
   kolmogorov/crespi/z has none: LAMMPS aborts with "Pair hybrid sub-style
   does not support single call"); a potential with an internal interlayer
   term, LJ-G/ILP/KC, or the
   interlayer comparison mode take the reaction-force branch instead.
   The builder passes `use_group_group` as a real bool; only `false` itself
   (`sameas`, so a 0 stub or an absent key keeps the old has_internal_lj
   rule) moves a run without an internal interlayer term off group/group. #}
{% if has_internal_lj or use_group_group is sameas false %}
{% if has_internal_lj %}
# Many-body potential ({{ pot_type }}): compute group/group not supported.
# Using bottom-sheet reaction forces as lateral friction proxy.
{% else %}
# Interlayer style without compute group/group (LJ-G/ILP/KC, or comparison mode):
# bottom-sheet reaction forces as the lateral friction proxy.
{% endif %}
variable        xfrict equal v_sx
variable        yfrict equal v_sy
{% else %}
compute         frict flake group/group layer_{{ n_layers }}
# compute group/group's VECTOR is a force in eV/A; the many-body branch above
# reports nN. Scale so both branches -- and v_fz, the load this is divided by --
# are nN. Unscaled here for the life of the project: see
# docs/notes/2026-08-27-sheet-cof-unit-correction.md.
variable        xfrict equal c_frict[1]*{{ ev_a_to_nn }}
variable        yfrict equal c_frict[2]*{{ ev_a_to_nn }}
{% endif %}

run             10000
{{ halt_guard.emit_halt_check(halt_temperature, halt_record, 'slide', 'pressure=$(v_pressure) angle=$(v_a) speed=$(v_speed)', 'slide_next') }}

{% if constraint_mode == 'com_spring' %}
# COM spring tethering the flake to the sheet top band.
fix             com_spring flake spring couple layer_{{ n_layers }} {{ bond_spring_ev }} 0.0 0.0 NULL 0.0
{% endif %}

variable        speed_x equal cos(v_a*PI/180)
variable        speed_y equal sin(v_a*PI/180)

{% if drive_method == 'smd' %}
fix             spr flake smd cvel {{ driving_spring_ev }} ${speed/100} tether $(v_speed_x) $(v_speed_y) NULL 0.0

{% elif drive_method == 'fix_move' %}
velocity        flake set 0.0 0.0 0.0 units box
velocity        flake set $(v_speed_x*v_speed/100) $(v_speed_y*v_speed/100) 0.0

{% elif drive_method == 'virtual_atom' %}
create_atoms    {{ num_atom_types }} single $(xcm(flake,x)) $(xcm(flake,y)) $(xcm(flake,z)+{{ virtual_offset }}) units box
group           virtual type {{ num_atom_types }}
velocity        virtual set 0.0 0.0 0.0

fix             spr flake spring couple virtual {{ driving_spring_ev }} 0.0 0.0 NULL 0
fix             move_virtual virtual move linear $(v_speed*v_speed_x/100) $(v_speed*v_speed_y/100) 0.0
{% endif %}

# Single sampling tier (spec §4): flake declares no raw- or peratom-tier
# channels, so those varlists filter to empty and build_obs_ctx's emptiness
# gate suppresses fc_raw/fc_pa entirely -- window only, matching what this
# template emitted before this conversion.
{{ obs.emit_output_fixes(obs_ctx) }}

run             {{ run_steps }}
{{ halt_guard.emit_halt_check(halt_temperature, halt_record, 'slide', 'pressure=$(v_pressure) angle=$(v_a) speed=$(v_speed)', 'slide_next') }}

# End-of-point snapshot (integrity stage 3); a halted point jumps past it.
write_data      {{ data_dir }}/final_p$(v_pressure)GPa_a$(v_a).data

# A halted point (common/halt.lmp) jumps here, past the rest of its slide.
label           slide_next

{% if scan_angle_config is iterable and scan_angle_config is not string and scan_angle_config|length > 0 %}
{% if scan_angle_force is number or scan_angle_force_is_sequence %}
if              'abs(v_pressure-v_scan_angle_force) < 1.0e-12' then &
                "next a" &
                "clear" &
                "jump SELF angle_loop"
{% else %}
next            a
clear
jump            SELF angle_loop
{% endif %}
{% endif %}

{% if scan_angle_config is iterable and scan_angle_config is not string and scan_angle_config|length > 0 and scan_angle_force_is_sequence %}
if              'abs(v_pressure-v_scan_angle_force) < 1.0e-12' then "next scan_angle_force"
{% endif %}

{% if pressures is iterable and pressures is not string %}
next            pressure
clear
{% if scan_angle_config is iterable and scan_angle_config is not string and scan_angle_config|length > 0 %}
variable        a delete
{% endif %}
jump            SELF pressure_loop
{% endif %}

{% if scan_speed_config is iterable and scan_speed_config is not string %}
next            speed
clear
{% if pressures is iterable and pressures is not string %}
variable        pressure delete
{% endif %}
{% if scan_angle_config is iterable and scan_angle_config is not string and scan_angle_config|length > 0 %}
variable        a delete
{% endif %}
jump            SELF speed_loop
{% endif %}
