#!/bin/bash
#SBATCH --nodes={{ nodes }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --cpus-per-task={{ cpus_per_task }}
#SBATCH --time={{ walltime }}
{% if array_size > 1 %}
#SBATCH --array=1-{{ array_size }}
#SBATCH --output={{ log_dir }}/{{ job_name }}_%a_out.txt
#SBATCH --error={{ log_dir }}/{{ job_name }}_%a_err.txt
{% else %}
#SBATCH --output={{ log_dir }}/{{ job_name }}_out.txt
#SBATCH --error={{ log_dir }}/{{ job_name }}_err.txt
{% endif %}
#SBATCH --job-name={{ job_name }}
{% if partition %}
#SBATCH --partition={{ partition }}
{% endif %}
{% if account %}
#SBATCH --account={{ account }}
{% endif %}
{% if mem %}
#SBATCH --mem={{ mem }}
{% endif %}

module purge
{% for mod in modules %}
module load {{ mod }}
{% endfor %}

{% if array_size > 1 %}
TASK_ID=${SLURM_ARRAY_TASK_ID}
{% else %}
TASK_ID=1
{% endif %}

SCRIPT_PATH=$(sed -n "${TASK_ID}p" $SLURM_SUBMIT_DIR/hpc/{{ manifest_filename }})
SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
SIM_PATH=$(dirname "$SCRIPT_DIR")

if [ -z "$SCRIPT_PATH" ]; then
    echo "Error: No script path for index ${TASK_ID}"
    exit 1
fi

{% if use_tmpdir %}
SIM_ROOT=$(basename "$SLURM_SUBMIT_DIR")
# Per-task scratch root keeps concurrent array tasks isolated from each other.
SCRATCH={{ scratch_dir }}/${SIM_ROOT}/task_${TASK_ID}

# Shared inputs (build/, provenance/potentials/) live at the simulation's
# config level, which may be an ancestor of SIM_PATH (e.g. AFM layer dirs share
# one provenance/ folder). Walk up to find it and copy that whole subtree so
# every relative path the LAMMPS script references resolves under SCRATCH.
COPY_ROOT="$SIM_PATH"
search="$SIM_PATH"
while [ "$search" != "." ] && [ "$search" != "/" ]; do
    if [ -d "$SLURM_SUBMIT_DIR/$search/provenance" ] || [ -d "$SLURM_SUBMIT_DIR/$search/build" ]; then
        COPY_ROOT="$search"
        break
    fi
    search=$(dirname "$search")
done

mkdir -p "$SCRATCH/$COPY_ROOT"
rsync -av --exclude='*.lammpstrj' --exclude='results/' --exclude='visuals/' "$SLURM_SUBMIT_DIR/$COPY_ROOT/" "$SCRATCH/$COPY_ROOT/"
mkdir -p "$SCRATCH/${SIM_PATH}/results" "$SCRATCH/${SIM_PATH}/visuals" "$SCRATCH/${SIM_PATH}/data"
cd $SCRATCH
{% else %}
cd $SLURM_SUBMIT_DIR
{% endif %}

# Tee stdout to a per-run log next to the input script: lmp_flags is "-l none",
# so LAMMPS writes no log of its own, and the settle loop's RAMP_STATUS /
# UNLOADED_REF lines would otherwise reach only the scheduler's spool file --
# which this job cannot read back to enrich provenance.json below.
# LMP_STATUS captures ${PIPESTATUS[0]} because $? is now tee's status, which is
# 0 even when LAMMPS died: testing it would turn every failure into a success.
{{ mpi_command }} lmp {{ lmp_flags }} -in ${SCRIPT_PATH} | tee ${SIM_PATH}/lammps/run.log
LMP_STATUS=${PIPESTATUS[0]}
if [ ${LMP_STATUS} -ne 0 ]; then
    echo "Error: LAMMPS failed on ${SCRIPT_PATH}"
    exit 1
fi

{% if use_tmpdir %}
mkdir -p "$SLURM_SUBMIT_DIR/${SIM_PATH}"
cp -r ${SIM_PATH}/results ${SIM_PATH}/visuals ${SIM_PATH}/data "$SLURM_SUBMIT_DIR/${SIM_PATH}/"
# Persist indentation load states so a dependent slide phase (AFM) can read them.
cp ${SIM_PATH}/load_*.data "$SLURM_SUBMIT_DIR/${SIM_PATH}/" 2>/dev/null || true
# The run log is written in scratch too; without this copy-back the
# RAMP_STATUS lines die with the scratch directory.
mkdir -p "$SLURM_SUBMIT_DIR/${SIM_PATH}/lammps"
cp ${SIM_PATH}/lammps/run.log "$SLURM_SUBMIT_DIR/${SIM_PATH}/lammps/" 2>/dev/null || true
{% endif %}

# Fold the settle loop's RAMP_STATUS/UNLOADED_REF lines into this run's
# provenance.json, against the final (workdir) copy rather than the scratch one.
# Guarded by `command -v` and `|| true` deliberately: a compute node without
# FrictionSim2D installed, or a run with no settle loop at all, must still
# finish green -- provenance enrichment is a nicety, never a reason to report a
# completed simulation as failed.
if command -v FrictionSim2D >/dev/null 2>&1; then
    FrictionSim2D hpc enrich-provenance "$SLURM_SUBMIT_DIR/${SIM_PATH}" "$SLURM_SUBMIT_DIR/${SIM_PATH}/lammps/run.log" || true
fi

echo "Simulation completed successfully: ${SIM_PATH}"
